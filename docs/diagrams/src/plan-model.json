{
 "type": "class",
 "title": "The plan and its tickets, and the records that lock them",
 "desc": "A plan lists one or more tickets, and each ticket owns 3 to 10 checklist items. The store writes a plan lock that fingerprints the plan, and up to two locks for each ticket's tests. A pass record from the gate names the fingerprint of the ticket's lock, and your approval of the same commit lets a tier 3 or 4 change merge.",
 "names": {"server": "Store", "check": "Gate", "you": "You"},
 "classes": [
  {"id": "planlock", "name": "Plan lock", "stereotype": "record", "col": 0, "row": 0,
   "kind": "server", "icon": "lock",
   "fields": ["task: str", "commit: str", "files: dict", "version: int (2 and up)", "at: str"]},
  {"id": "plan", "name": "Plan", "stereotype": "dataclass", "col": 1, "row": 0,
   "kind": "ai", "icon": "plan",
   "fields": ["id: str", "tickets: list", "sections: dict", "files: dict", "assumptions: list"]},
  {"id": "lock", "name": "Lock", "stereotype": "record", "col": 0, "row": 1,
   "kind": "server", "icon": "lock",
   "fields": ["ticket: str", "base_commit: str", "commit: str", "manifest: dict",
              "number: int", "at: str"]},
  {"id": "ticket", "name": "Ticket", "stereotype": "dataclass", "col": 1, "row": 1,
   "kind": "ai", "icon": "ticket",
   "fields": ["id: str", "plan: str", "seams: list", "tests: list", "items: list",
              "sections: dict", "fixes: str", "not_covered: dict"],
   "methods": ["item(item_id) Item"]},
  {"id": "item", "name": "Item", "stereotype": "dataclass", "col": 2, "row": 1,
   "kind": "ai", "icon": "test",
   "fields": ["id: str", "text: str", "must: bool", "keeps_behavior: bool", "kind: str | None"]},
  {"id": "pass", "name": "Pass record", "stereotype": "record", "col": 0, "row": 2,
   "kind": "check", "icon": "gate",
   "fields": ["commit: str", "ticket: str", "tier: int", "base_commit: str", "lock_sha256: str",
              "checks: dict", "score: int", "at: str"]},
  {"id": "approval", "name": "Approval", "stereotype": "record", "col": 1, "row": 2,
   "kind": "you", "icon": "terminal",
   "fields": ["commit: str", "ticket: str", "approver: str", "at: str"]}
 ],
 "relations": [
  {"from": "planlock", "to": "plan", "type": "association", "arrow": true,
   "ends": ["0..1", "1"], "label": "fingerprints"},
  {"from": "plan", "to": "ticket", "type": "has", "ends": ["1", "1..*"], "roles": ["", "tickets"]},
  {"from": "ticket", "to": "item", "type": "owns", "ends": ["1", "3..10"], "roles": ["", "items"]},
  {"from": "lock", "to": "ticket", "type": "association", "arrow": true,
   "ends": ["0..2", "1"], "label": "locks the tests of"},
  {"from": "pass", "to": "lock", "type": "association", "arrow": true,
   "ends": ["0..*", "1"], "label": "names the fingerprint of"},
  {"from": "approval", "to": "pass", "type": "association", "arrow": true,
   "ends": ["0..1", "0..1"], "label": "the same commit"}
 ]
}
