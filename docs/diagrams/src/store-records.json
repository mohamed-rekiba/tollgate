{
 "type": "er",
 "title": "The records the store keeps, and the keys that link them",
 "desc": "The store keeps records as files in the state folder, not in a database. A plan lock lists the tickets of a task; each ticket has a lock of its tests, and at most one older lock it replaced. A pass record names its ticket and the fingerprint of the lock, and the commit it started from, which has its own pass record unless it is main. A ready change and your approval name the commit of a pass record.",
 "names": {"server": "Store", "check": "Gate", "you": "You"},
 "tables": [
  {"id": "plans", "name": "plan locks", "col": 0, "row": 0, "kind": "server", "icon": "plan",
   "columns": [{"name": "task", "type": "text", "key": "pk"},
               {"name": "commit", "type": "commit"},
               {"name": "files", "type": "object"},
               {"name": "version", "type": "int"},
               {"name": "at", "type": "time"}]},
  {"id": "oldplans", "name": "replaced plan locks", "col": 1, "row": 0, "kind": "server",
   "icon": "plan",
   "columns": [{"name": "task", "type": "text", "key": "pk fk"},
               {"name": "version", "type": "int", "key": "pk"},
               {"name": "commit", "type": "commit"},
               {"name": "files", "type": "object"}]},
  {"id": "locks", "name": "locks", "col": 0, "row": 1, "kind": "server", "icon": "lock",
   "columns": [{"name": "ticket", "type": "text", "key": "pk"},
               {"name": "base_commit", "type": "commit"},
               {"name": "commit", "type": "commit"},
               {"name": "manifest", "type": "object"},
               {"name": "number", "type": "1 or 2"},
               {"name": "at", "type": "time"}]},
  {"id": "passes", "name": "pass records", "col": 1, "row": 1, "kind": "check", "icon": "gate",
   "columns": [{"name": "commit", "type": "commit", "key": "pk"},
               {"name": "ticket", "type": "text", "key": "fk"},
               {"name": "lock_sha256", "type": "text", "key": "fk"},
               {"name": "base_commit", "type": "commit", "key": "fk"},
               {"name": "tier", "type": "1 to 4"},
               {"name": "checks", "type": "object"},
               {"name": "score", "type": "int"},
               {"name": "at", "type": "time"}]},
  {"id": "ready", "name": "ready changes", "col": 2, "row": 1, "kind": "check", "icon": "merge",
   "columns": [{"name": "ticket", "type": "text", "key": "pk"},
               {"name": "commit", "type": "commit", "key": "fk"},
               {"name": "branch", "type": "text"},
               {"name": "at", "type": "time"}]},
  {"id": "oldlocks", "name": "replaced locks", "col": 0, "row": 2, "kind": "server",
   "icon": "lock",
   "columns": [{"name": "ticket", "type": "text", "key": "pk fk"},
               {"name": "commit", "type": "commit"},
               {"name": "manifest", "type": "object"},
               {"name": "number", "type": "1"}]},
  {"id": "approvals", "name": "approvals", "col": 1, "row": 2, "kind": "you", "icon": "terminal",
   "columns": [{"name": "commit", "type": "commit", "key": "pk"},
               {"name": "ticket", "type": "text"},
               {"name": "approver", "type": "text"},
               {"name": "at", "type": "time"}]}
 ],
 "relations": [
  {"from": "plans", "to": "oldplans", "ends": ["exactly one", "zero or many"], "label": "replaced"},
  {"from": "plans", "to": "locks", "ends": ["zero or one", "zero or many"],
   "label": "lists the ticket"},
  {"from": "locks", "to": "oldlocks", "ends": ["exactly one", "zero or one"], "label": "replaced"},
  {"from": "locks", "to": "passes", "ends": ["exactly one", "zero or many"],
   "label": "fingerprint"},
  {"from": "passes", "to": "passes", "ends": ["zero or one", "zero or many"],
   "label": "started from"},
  {"from": "passes", "to": "ready", "ends": ["exactly one", "zero or one"]},
  {"from": "passes", "to": "approvals", "ends": ["zero or one", "zero or one"],
   "label": "the same commit"}
 ]
}
