{
 "type": "state",
 "title": "The life of a task",
 "desc": "A task is analyzed, planned, and approved, then each ticket is built in order, each from the ready change before it: tests first, then tries at the gate until one passes or a stop sends it to the advisor. Every ready change is held. When every ticket is ready, a reviewer reads the whole task. Problems in the first review start one fix round: the plan gets new tickets, is approved and locked again, and the new tickets are built. Once the review passes, the tickets merge in plan order. A question, a parked ticket, a send-back, or a stop at a checkpoint makes the task wait for you; when it runs again, it skips every finished step.",
 "names": {
  "server": "Store"
 },
 "states": [
  {
   "id": "start",
   "initial": true,
   "col": 0,
   "row": 0
  },
  {
   "id": "analyzing",
   "text": "Analyzing\nThe analyst reads\nthe project",
   "col": 1,
   "row": 0,
   "kind": "ai",
   "icon": "search"
  },
  {
   "id": "planning",
   "text": "Planning\nThe builder writes it,\nreviewers check it",
   "col": 2,
   "row": 0,
   "kind": "ai",
   "icon": "plan"
  },
  {
   "id": "approval",
   "text": "Plan approval\nThe advisor approves\nor sends it back",
   "col": 3,
   "row": 0,
   "kind": "advisor"
  },
  {
   "id": "waits",
   "text": "The task waits\nFor you; it starts again\nwhere it stopped",
   "col": 4,
   "row": 0,
   "kind": "you",
   "icon": "bell"
  },
  {
   "id": "tickets",
   "text": "Building the tickets\nIn plan order, each from\nthe ready change before it",
   "col": 0,
   "row": 1,
   "kind": "ai",
   "icon": "ticket"
  },
  {
   "id": "ticket_start",
   "initial": true,
   "col": 0,
   "row": 0,
   "parent": "tickets"
  },
  {
   "id": "tests",
