--- a/action/manifest.py
+++ b/action/manifest.py
@@ -3,10 +3,12 @@
 The manifest lives in the message of the freeze tag, as JSON.
 """
 
+import argparse
 import json
+import sys
 
 from action import junit
-from action.gitio import fingerprint, show_bytes
+from action.gitio import GitError, fingerprint, git, show_bytes
 from action.tickets import item_of_test
 
 TICKET_DIR = ".tollgate/tickets"
@@ -84,3 +86,34 @@ def loads(text: str) -> dict:
     if start < 0:
         raise FreezeError("the tag message holds no manifest")
     return json.loads(text[start : text.rfind("}") + 1])
+
+
+def lines(manifest: dict) -> list:
+    """Return the manifest as plain lines: ticket, commit, files, tests."""
+    return [
+        manifest["ticket"],
+        manifest["commit"],
+        *sorted(manifest["files"]),
+        *manifest["tests"],
+    ]
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(prog="action.manifest", description="Print the freeze manifest of a tag.")
+    parser.add_argument("--repo", required=True)
+    parser.add_argument("--tag", required=True)
+    args = parser.parse_args(argv)
+    try:
+        text = git(args.repo, "for-each-ref", "--format=%(contents)", f"refs/tags/{args.tag}")
+        if not text.strip():
+            raise FreezeError(f"no tag {args.tag}")
+        out = lines(loads(text))
+    except (GitError, FreezeError, ValueError, KeyError) as err:
+        print(f"cannot read the manifest: {err}", file=sys.stderr)
+        return 1
+    print("\n".join(out))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/test_manifest_cli.py b/tests/test_manifest_cli.py
new file mode 100644
index 0000000..82b3364
--- /dev/null
+++ b/tests/test_manifest_cli.py
@@ -0,0 +1,49 @@
+"""Tests for python3 -m action.manifest."""
+
+import contextlib
+import io
+import unittest
+
+from action import manifest as mf
+from tests.helpers import Repo
+
+
+def run(*argv):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        code = mf.main(list(argv))
+    return code, out.getvalue(), err.getvalue()
+
+
+class ManifestCliTest(unittest.TestCase):
+    def setUp(self):
+        self.repo = Repo()
+        self.addCleanup(self.repo.close)
+        self.repo.write("a.txt", "a\n")
+        self.repo.commit()
+
+    def test_prints_lines(self):
+        m = {"ticket": "T-1", "commit": "abc123",
+             "files": {"tests/test_b.py": "sha256:1", ".tollgate/tickets/T-1/ticket.md": "sha256:2"},
+             "tests": ["tests.test_b::test_c1_x", "tests.test_b::test_c2_y"]}
+        self.repo.tag("freeze-1", f"Freeze 1\n\n{mf.dumps(m)}\n")
+        code, out, _ = run("--repo", str(self.repo.path), "--tag", "freeze-1")
+        self.assertEqual(code, 0)
+        self.assertEqual(out.splitlines(), [
+            "T-1", "abc123", ".tollgate/tickets/T-1/ticket.md", "tests/test_b.py",
+            "tests.test_b::test_c1_x", "tests.test_b::test_c2_y"])
+
+    def test_missing_tag(self):
+        code, out, err = run("--repo", str(self.repo.path), "--tag", "nope")
+        self.assertEqual((code, out), (1, ""))
+        self.assertIn("no tag", err)
+
+    def test_tag_without_manifest(self):
+        self.repo.tag("plain", "just words")
+        code, _, err = run("--repo", str(self.repo.path), "--tag", "plain")
+        self.assertEqual(code, 1)
+        self.assertIn("no manifest", err)
+
+
+if __name__ == "__main__":
+    unittest.main()
