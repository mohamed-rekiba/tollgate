{
  "setup": [
    "python3 -m pip install --quiet --user pytest pyyaml || python3 -m pip install --quiet --break-system-packages pytest pyyaml"
  ],
  "checks": {
    "tests": {
      "run": "python3 -m pytest -q -p no:cacheprovider --junitxml=report.xml tests",
      "report": "report.xml",
      "minutes": 15
    },
    "style": {
      "run": "pipx run ruff check ."
    },
    "writing": {
      "run": "python3 setup/check_writing.py"
    }
  },
  "harness": [
    "tests/helpers.py",
    "tests/fakes.py",
    "tests/fake_role.py"
  ],
  "tiers": {
    "3": [
      "driver/**",
      "roles/**",
      "lenses/**"
    ],
    "4": [
      "gate/**",
      "setup/**",
      "skills/init/**",
      "hooks/**"
    ]
  },
  "require_plan": false,
  "auto_merge": false,
  "container_image": "tollgate-builder:ci",
  "ai": {
    "advisor": [
      "claude -p"
    ]
  },
  "stop": {
    "attempts": 3,
    "attempt_minutes": 30,
    "ticket_usd": 5.0,
    "task_usd": 60.0
  },
  "signers": [],
  "owners": [],
  "isolation": "container"
}
