{
  "setup": [],
  "checks": {
    "tests": {
      "run": "uv run --no-project --with-requirements requirements-dev.txt pytest -q -p no:cacheprovider -n auto --junitxml=report.xml tests",
      "report": "report.xml",
      "minutes": 15
    },
    "style": {
      "run": "uv run --no-project --with-requirements requirements-dev.txt ruff check ."
    },
    "writing": {
      "run": "uv run --no-project python setup/check_writing.py"
    }
  },
  "harness": [
    "tests/helpers.py",
    "tests/fakes.py",
    "tests/fake_role.py",
    "checks/check_writing.py",
    "checks/**",
    ".pre-commit-config.yaml",
    ".tollgate/checks/check_writing.py",
    ".tollgate/checks/**"
  ],
  "tiers": {
    "3": [
      "driver/**",
      "roles/**",
      "lenses/**"
    ],
    "4": [
      "gate/**",
      "setup/**",
      "skills/init/**",
      "hooks/**"
    ]
  },
  "require_plan": false,
  "auto_merge": false,
  "container_image": "tollgate-builder:ci",
  "ai": {
    "advisor": [
      "claude -p"
    ]
  },
  "stop": {
    "attempts": 3,
    "attempt_minutes": 30,
    "ticket_usd": 5.0,
    "task_usd": 60.0
  },
  "isolation": "container"
}
